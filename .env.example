# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Runtime Configuration
PORT=8080
APP_MODE="demo"
ALLOW_DEMO_ROLE_SWITCH="true"
PERSISTENCE_DRIVER="sqlite"
SQLITE_DB_PATH="./data/lablink.db"
CAMPUS_TIMEZONE="Asia/Kolkata"
NO_SHOW_GRACE_MINUTES=20
INTERNAL_SWEEP_SECRET=""

# Server-Side Firebase Admin (Production Mode / Firestore)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Client Public Firebase Configuration (Production Mode)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
